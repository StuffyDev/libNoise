// src/render/noise.frag
#version 330 core

// Входные данные: UV-координаты от 0 до 1 (интерполированы от вершин)
in vec2 FragCoord;

// Параметры шума, которые будут переданы из C++
uniform int u_noiseType; // 0: Perlin, 1: Simplex, 2: Worley, 3: FBM, etc.
uniform float u_scale;   // Масштаб (частота)
uniform int u_octaves;   // Октавы (для FBM)

out vec4 FragColor;

// Здесь должен быть реализован код для выбранного алгоритма шума,
// но это ОЧЕНЬ СЛОЖНО: портировать весь C++ шум в GLSL.
//
// Простой подход:
// Вместо реализации всего шума в GLSL, мы сосредоточимся на том,
// чтобы C++ вычислял шум и копировал его в текстуру, а GLSL просто читал текстуру.
//
// Более продвинутый (но сложный) подход: Реализовать шум прямо в GLSL.
// Поскольку у нас нет кода C++ в GLSL, мы просто используем временную заглушку.

float calculateNoise(vec2 uv) {
    // Временная заглушка: используем встроенный в GLSL шум для теста
    // (Позже C++ будет передавать шум как текстуру)
    if (u_noiseType == 0) {
        // Простая волна для демонстрации
        return sin(uv.x * u_scale * 10.0) * 0.5 + 0.5;
    } else {
        // Временный шум, если тип не 0
        return fract(sin(dot(uv * u_scale, vec2(12.9898, 78.233))) * 43758.5453);
    }
}

void main() {
    float noiseValue = calculateNoise(FragCoord);

    // Преобразуем значение [0, 1] в градиент серого
    FragColor = vec4(vec3(noiseValue), 1.0);
}
